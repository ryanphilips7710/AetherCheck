{
  "manifest_version": 3,
  "name": "AetherCheck - Voice Integrity Guard",
  "version": "1.0.0",
  "description": "Real-time AI voice cloning and impersonation detection",
  "permissions": [
    "tabCapture",
    "offscreen",
    "activeTab",
    "notifications",
    "scripting"
  ],
  "action": {
    "default_title": "AetherCheck: Click to Toggle Inspection"
  },
  "background": {
    "service_worker": "background.js"
  },
  "host_permissions": [
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://meet.google.com/*",
        "https://*.zoom.us/*",
        "http://localhost/*"
      ],
      "js": [
        "content/overlay.js"
      ],
      "css": [
        "content/overlay.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "content/overlay.js",
        "content/overlay.css"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
